#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include "torabo-pointing.dtsi"

/ {
    chosen {
        zmk,physical-layout = &physical_layout_s;
    };

    behaviors {
        // Vialのマクロと同じ順にCtrlを押し、Spaceを20ミリ秒だけ押して両方を解放する。
        ZMK_MACRO(ctrl_space,
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_press &kp LCTRL>,
                       <&macro_tap &kp SPACE>,
                       <&macro_release &kp LCTRL>;
        )

        // X長押しでメディア層。判定を短くする（ノード名 hold_tap の重複を避ける）。
        media_x: media_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <120>;
            quick-tap-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // メーカーのS配列の順序に合わせ、各行を左手の外側から右手の外側へ並べる。
        layer_0 {
            display-name = "基本";
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I  &kp O  &mo 8
                &kp A  &kp S  &lt 3 D  &lt 2 F  &kp G    &kp H  &kp J  &kp K  &kp L  &kp P
                &mt LCTRL Z  &media_x 9 X  &lt 5 C  &lt 4 V  &lt 6 B    &none  &kp N  &kp M  &none  &to 1
                &kp CAPSLOCK  &kp LGUI  &kp LALT  &kp LALT  &mt LGUI RET  &mt LSHFT SPACE    &mt RSHFT SPACE  &mt RGUI RET  &none  &none  &none  &to 0
            >;
        };

        // ボールで入るマウス層。H戻る J左クリック K右クリック L進む。N長押し相当は mo でスクロール。
        layer_1 {
            display-name = "マウス";
            bindings = <
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &mkp MB4  &mkp LCLK  &mkp RCLK  &mkp MB5  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &mo 8  &mkp LCLK  &trans  &to 0
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &to 0
            >;
        };

        // 左手のFを保持してBを押すと、Macでキー一覧を開くF24を送る。
        // F+Nで英数(ABC)、F+Mでかな(あいう)。MacのLANG2/LANG1に対応する。
        // 一番右下は全レイヤーで &to 0（基本レイヤーへ強制復帰）。
        layer_2 {
            display-name = "移動";
            bindings = <
                &kp ESC  &trans  &kp BSPC  &trans  &trans    &trans  &kp BSPC  &trans  &trans  &kp DEL
                &kp TAB  &kp TAB  &kp LGUI  &trans  &trans    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
                &trans  &trans  &trans  &trans  &kp F24    &trans  &kp LANG2  &kp LANG1  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            display-name = "数字";
            bindings = <
                &trans  &trans  &trans  &trans  &trans    &trans  &kp N7  &kp N8  &kp N9  &none
                &trans  &trans  &trans  &trans  &trans    &trans  &kp N4  &kp N5  &kp N6  &kp N0
                &trans  &trans  &trans  &trans  &trans    &trans  &kp N1  &kp N2  &kp N3  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Karabinerのv長押しと同じ記号配置（右手）。
        // Y¥ U- I= O[ / H~ J; K' L\ P] / N, M. (M右隣)/
        layer_4 {
            display-name = "記号";
            bindings = <
                &trans  &trans  &trans  &trans  &trans    &kp INTERNATIONAL_3  &kp MINUS  &kp EQUAL  &kp LBKT  &trans
                &trans  &trans  &trans  &trans  &trans    &kp LS(GRAVE)  &kp SEMI  &kp SQT  &kp BSLH  &kp RBKT
                &trans  &trans  &trans  &trans  &trans    &trans  &kp COMMA  &kp DOT  &kp FSLH  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // C長押し。標準の F1–F12（Karabinerでメディア化を防ぐ）。数字層と同じ位置。
        // Y=F12 U=F7 I=F8 O=F9 / H=F11 J=F4 K=F5 L=F6 P=F10 / N=F1 M=F2 (M右)=F3
        layer_5 {
            display-name = "ファンクション";
            bindings = <
                &trans  &trans  &trans  &trans  &trans    &kp F12  &kp F7  &kp F8  &kp F9  &trans
                &trans  &trans  &trans  &trans  &trans    &kp F11  &kp F4  &kp F5  &kp F6  &kp F10
                &trans  &trans  &trans  &trans  &trans    &trans  &kp F1  &kp F2  &kp F3  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // このZMK版が送信できるConsumerページの電源とスリープを使用する。
        // B長押し+Dで現在のBTプロファイル消去、B長押し+Fでプロファイル0選択（Mac再ペア用）。
        layer_6 {
            display-name = "記号・電源";
            bindings = <
                &kp C_POWER  &trans  &trans  &trans  &trans    &kp EQUAL  &kp BSPC  &kp MINUS  &kp GRAVE  &kp C_SLEEP
                &kp N1  &trans  &bt BT_CLR  &bt BT_SEL 0  &trans    &kp LS(BSLH)  &kp RBKT  &kp RBKT  &kp NON_US_HASH  &bootloader
                &trans  &kp C_EJECT  &kp LGUI  &kp LALT  &trans    &kp BSLH  &kp SQT  &kp LBKT  &kp NON_US_BSLH  &kp INTERNATIONAL_1
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &kp SQT  &kp INTERNATIONAL_1  &trans
            >;
        };

        layer_7 {
            display-name = "マウス固定";
            bindings = <
                &trans  &trans  &trans  &trans  &trans    &trans  &mkp MB4  &trans  &mkp MB5  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &mkp LCLK  &mo 8  &mkp RCLK  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &to 0
            >;
        };

        // スクロールキーを保持している間だけこのレイヤーでボールをホイールとして扱う。
        drag_scroll {
            display-name = "スクロール";
            bindings = <
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // X長押し。MacのFキー帯に相当するメディア／輝度／Mission Control。
        // Y音量+ U前 I再生 O次 / H音量- J Launchpad K輝度- L輝度+ Pミュート / N輝度- M輝度+ (M右)Mission Control
        media {
            display-name = "メディア";
            bindings = <
                &trans  &trans  &trans  &trans  &trans    &kp C_VOL_UP  &kp C_PREV  &kp C_PP  &kp C_NEXT  &trans
                &trans  &trans  &trans  &trans  &trans    &kp C_VOL_DN  &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS  &kp C_BRI_DEC  &kp C_BRI_INC  &kp C_MUTE
                &trans  &trans  &trans  &trans  &trans    &trans  &kp C_BRI_DEC  &kp C_BRI_INC  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

// このキーマップはS配列専用なので、StudioでMやLを選択して割り当てがずれるのを防ぐ。
&physical_layout_m { status = "disabled"; };
&physical_layout_l { status = "disabled"; };

// QMK実機から読み取った255ミリ秒と、レイヤーおよび修飾キーそれぞれの割り込み判定を再現する。
&lt {
    tapping-term-ms = <255>;
    quick-tap-ms = <255>;
    flavor = "hold-preferred";
};

&mt {
    tapping-term-ms = <255>;
    quick-tap-ms = <255>;
    flavor = "balanced";
};
